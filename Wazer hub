activateBtn.MouseButton1Click:Connect(function()
	local enteredKey = keyTextBox.Text
	if enteredKey == CORRECT_KEY then
		isAuthorized = true
		keyScreenGui:Destroy()
		screenGui.Enabled = true
		sendGlobalChatMessage("⚽تم تفعيل برايم مناف⚽") -- <-- الرسالة المطلوبة
		showNotification("✅ تم التفعيل بنجاح!")
	else
		keyAttempts = keyAttempts + 1
		if keyAttempts == 1 then
			showNotification("❌ روح جيب المفتاح")
		elseif keyAttempts == 2 then
			showNotification("⚠️ انت هتهزر معايا")
		elseif keyAttempts >= 3 then
			player:Kick("🚫 عشان تهزر تاني")
		end
	end
end)

