-- ==================== دالة إرسال رسالة للكل (نسخة مطورة) ====================
local function sendGlobalChatMessage(message)
	local success, err = pcall(function()
		-- المحاولة الأولى: النظام القديم (الأكثر شيوعاً)
		local chatService = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		if chatService then
			local sayMessageRequest = chatService:FindFirstChild("SayMessageRequest")
			if sayMessageRequest then
				sayMessageRequest:InvokeServer(message, "All")
				return
			end
		end

		-- المحاولة الثانية: النظام الجديد (TextChatService)
		if TextChatService then
			local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if generalChannel and generalChannel:IsA("TextChannel") then
				generalChannel:SendAsync(message)
				return
			end

			local textChannels = TextChatService:FindFirstChild("TextChannels")
			if textChannels then
				for _, channel in pairs(textChannels:GetChildren()) do
					if channel:IsA("TextChannel") and channel.CanSendAsync then
						channel:SendAsync(message)
						return
					end
				end
			end
		end

		-- المحاولة الثالثة: طريقة بديلة (RemoteEvent مباشر)
		local remoteEvent = ReplicatedStorage:FindFirstChild("SayMessageRequest")
		if remoteEvent and remoteEvent:IsA("RemoteEvent") then
			remoteEvent:FireServer(message, "All")
			return
		end
	end)

	if not success then
		warn("فشل إرسال الرسالة للشات: " .. tostring(err))
	end
end

