-- دالة الحصول على الهدف
local function GetTarget(input)
    if not input or input == "" then return nil end
    local search = input:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and (p.Name:lower():find(search, 1, true) or p.DisplayName:lower():find(search, 1, true)) then
            return p
        end
    end
    return nil
end

-- دالة تجهيز الأدوات (زي Zenix بالضبط)
local function EquipTools()
    local char = lp.Character
    if not char then return end
    
    local tools = {}
    for _, tool in ipairs(lp.Backpack:GetChildren()) do
        if tool:IsA("Tool") and #tools < 6 then
            table.insert(tools, tool)
        end
    end
    
    for i, tool in ipairs(tools) do
        task.wait(0.05)
        tool.Parent = char
    end
end

-- دالة المؤثرات البصرية (تأثير Zenix)
local function CreateBangEffect(position)
    if not Settings.Effects then return end
    
    -- تأثير ناري
    local fire = Instance.new("Part")
    fire.Size = Vector3.new(2, 2, 2)
    fire.Position = position
    fire.Anchored = true
    fire.CanCollide = false
    fire.Transparency = 0.5
    fire.BrickColor = BrickColor.new("Bright red")
    fire.Material = Enum.Material.Neon
    fire.Parent = game.Workspace
    
    -- تأثير دخان
    local smoke = Instance.new("Smoke")
    smoke.Color = Color3.new(1, 0.3, 0.3)
    smoke.Opacity = 0.8
    smoke.RiseVelocity = 5
    smoke.Parent = fire
    
    Debris:AddItem(fire, 1.5)
    
    -- تأثير اهتزاز للكاميرا
    if game:GetService("Workspace").CurrentCamera then
        local cam = game:GetService("Workspace").CurrentCamera
        local originalCF = cam.CFrame
        for i = 1, 5 do
            cam.CFrame = cam.CFrame * CFrame.new(math.random(-1,1)/10, math.random(-1,1)/10, math.random(-1,1)/10)
            task.wait(0.02)
        end
        cam.CFrame = originalCF
    end
end

-- الحلقة الرئيسية لحركة البانق (مطابقة لـ Zenix)
RunService.Stepped:Connect(function()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not char or not hrp or not hum then return end
    
    -- وضعية القيادة
    local vehicle = char:FindFirstChildOfClass("VehicleSeat") and char:FindFirstChildOfClass("VehicleSeat").Parent
    if Settings.DriveMode and vehicle and vehicle:IsA("Vehicle") then
        hrp.CFrame = hrp.CFrame
        return
    end
    
    if bangActive and currentTarget and currentTarget.Character then
        local targetChar = currentTarget.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHead = targetChar:FindFirstChild("Head")
        local targetTorso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
        
        if targetHRP and (targetHead or targetTorso) then
            -- منع السقوط (Anti-Fall)
            if Settings.AntiFall and hrp.Position.Y < 0 then
                hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
            end
            
            -- منع الالتصاق (Anti-Stuck)
            if Settings.AntiStuck and lastPosition and (hrp.Position - lastPosition).Magnitude < 0.1 then
                if not isStuck then
                    isStuck = true
                    hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-2,2), math.random(1,3), math.random(-2,2))
                end
            else
                isStuck = false
            end
            lastPosition = hrp.Position
            
            -- منع الجلوس
            hum.Sit = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            
            -- إلغاء التصادم
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = false
                end
            end
            
            -- سرعة البانق (تأثير الاهتزاز)
            local wave = math.sin(tick() * Settings.Speed)
            local offset = wave * 0.8
            
            -- الوضعيات المختلفة
            if bangMode == "back" then
                -- بانق خلفي (الوضعية الأساسية)
                hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0.5, Settings.Distance + offset)
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
                
            elseif bangMode == "face" then
                -- فيس سيت (على الوجه)
                if targetHead then
                    hrp.CFrame = targetHead.CFrame * CFrame.new(0, -0.6, offset) * CFrame.Angles(0, math.rad(180), 0)
                end
                
            elseif bangMode == "climb" then
                -- وضع التسلق (يتحرك حول الهدف)
                local angle = tick() * 3
                local radius = 2
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius
                hrp.CFrame = targetHRP.CFrame * CFrame.new(x, 0.5, z)
                
            elseif bangMode == "drive" then
                -- وضع القيادة (يقف خلف الهدف)
                hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
            end
            
            -- إبقاء السرعة صفر
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            
        else
            -- إذا مات الهدف أو اختفى
            bangActive = false
            currentTarget = nil
            if originalCFrame and not bangActive then
                hrp.CFrame = originalCFrame
                originalCFrame = nil
            end
        end
    elseif originalCFrame and not bangActive then
        hrp.CFrame = originalCFrame
        originalCFrame = nil
    end
end)

